# http-level hardening. Rendered at container start by docker-entrypoint.d/18-kickedro-render.sh into
# /etc/nginx/modsec/rendered/hardening.conf, which nginx.conf includes in the http block before conf.d (see the
# Dockerfile). Every value comes from a setting in edge/settings.tsv, documented in docs/settings.md. A directive
# below that starts with "# " is switched off by its on/off setting.
#
# All of these are inherited by every server and location of nginx-proxy's generated configuration. Of these
# directives the template itself sets only add_header (HSTS, see below) and server_tokens (its fallback server, and a
# vhost whose container has SERVER_TOKENS). A vhost snippet that sets a directive of the same kind replaces the
# inherited value for its vhost (for *_hide_header and sub_filter: all the inherited ones).

# Hide the nginx version in the Server header and on error pages (EDGE_SERVER_TOKENS).
server_tokens ${EDGE_SERVER_TOKENS};

# Short client timeouts against slow-request attacks, and the size of the buffers for long request lines and headers
# (EDGE_CLIENT_HEADER_TIMEOUT, EDGE_CLIENT_BODY_TIMEOUT, EDGE_SEND_TIMEOUT, EDGE_KEEPALIVE_TIMEOUT,
# EDGE_LARGE_HEADER_BUFFERS).
client_header_timeout ${EDGE_CLIENT_HEADER_TIMEOUT};
client_body_timeout ${EDGE_CLIENT_BODY_TIMEOUT};
send_timeout ${EDGE_SEND_TIMEOUT};
keepalive_timeout ${EDGE_KEEPALIVE_TIMEOUT};
large_client_header_buffers ${EDGE_LARGE_HEADER_BUFFERS};

# Backend headers that reveal software and versions, for each upstream protocol of nginx-proxy's template
# (EDGE_HIDE_UPSTREAM_HEADERS).
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}proxy_hide_header X-Powered-By;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}proxy_hide_header Server;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}proxy_hide_header X-AspNet-Version;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}proxy_hide_header X-AspNetMvc-Version;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}fastcgi_hide_header X-Powered-By;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}fastcgi_hide_header Server;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}fastcgi_hide_header X-AspNet-Version;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}fastcgi_hide_header X-AspNetMvc-Version;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}uwsgi_hide_header X-Powered-By;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}uwsgi_hide_header Server;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}uwsgi_hide_header X-AspNet-Version;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}uwsgi_hide_header X-AspNetMvc-Version;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}grpc_hide_header X-Powered-By;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}grpc_hide_header Server;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}grpc_hide_header X-AspNet-Version;
${KICKEDRO_IF_HIDE_UPSTREAM_HEADERS}grpc_hide_header X-AspNetMvc-Version;

# Security headers on every response, error pages and the block page included ("always") (EDGE_SECURITY_HEADERS).
# By default nginx drops http-level add_header directives in every server or location that has an add_header of its
# own (nginx-proxy's HSTS, vhost snippets); "add_header_inherit merge" (nginx 1.29.3) adds them there after the
# local ones instead. Each header is added only when the response does not have it yet (sent by the backend, or
# added by the vhost): browsers ignore X-Frame-Options when it has two different values.
${KICKEDRO_IF_SECURITY_HEADERS}add_header_inherit merge;
${KICKEDRO_IF_SECURITY_HEADERS}add_header X-Content-Type-Options $kickedro_x_content_type_options always;
${KICKEDRO_IF_SECURITY_HEADERS}add_header Referrer-Policy $kickedro_referrer_policy always;
${KICKEDRO_IF_SECURITY_HEADERS}add_header X-Frame-Options $kickedro_x_frame_options always;
# An empty value adds no header. "volatile": evaluated when the header is added, never from an earlier lookup.
map $sent_http_x_content_type_options $kickedro_x_content_type_options {
    volatile;
    "" "nosniff";
    default "";
}
map $sent_http_referrer_policy $kickedro_referrer_policy {
    volatile;
    "" "strict-origin-when-cross-origin";
    default "";
}
map $sent_http_x_frame_options $kickedro_x_frame_options {
    volatile;
    "" "SAMEORIGIN";
    default "";
}

# Rate-limit zones for vhost snippets ("limit_req zone=kickedro_login_1rs;"), applied nowhere by default
# (EDGE_RATE_ZONES). 10 MB hold about 160,000 client addresses.
${KICKEDRO_IF_RATE_ZONES}limit_req_zone $binary_remote_addr zone=kickedro_perip_10rs:10m rate=10r/s;
${KICKEDRO_IF_RATE_ZONES}limit_req_zone $binary_remote_addr zone=kickedro_login_1rs:10m rate=1r/s;

# Friendly block page with a reference (EDGE_BLOCK_PAGE), generated by docker-entrypoint.d/19-kickedro-block-page.sh.
include /etc/nginx/modsec/rendered/block-page.conf;
