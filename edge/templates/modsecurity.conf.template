# Settings derived from MODSEC_* environment variables. Rendered at container start by
# docker-entrypoint.d/18-kickedro-render.sh (envsubst) into /etc/nginx/modsec/rendered/ and loaded after the CRS's crs-setup.conf.
# Fixed settings are in modsecurity/modsecurity.conf; no directive appears in both.

SecRuleEngine ${MODSEC_RULE_ENGINE}
SecRequestBodyLimit ${MODSEC_REQ_BODY_LIMIT}
# Limit for a body without its file uploads (forms, JSON, XML): over it, REQBODY_ERROR is set and rule 200002 refuses
# the request.
SecRequestBodyNoFilesLimit ${MODSEC_REQ_BODY_NOFILES_LIMIT}

# ModSecurity parses at most this many arguments; a request that reaches the limit is refused, because the arguments
# beyond it would not be inspected.
SecArgumentsLimit ${MODSEC_ARGUMENTS_LIMIT}

# Request body checks of libmodsecurity's recommended configuration, refusing with the deny status so the request gets
# the block page and its reference. They are here and not in modsecurity/modsecurity.conf with an update by ID (as
# for the CRS's blocking rules): libmodsecurity applies a rule's own status after an updated one.
SecRule &ARGS "@ge ${MODSEC_ARGUMENTS_LIMIT}" \
    "id:'200007',phase:2,t:none,log,deny,status:${MODSEC_DENY_STATUS},msg:'Failed to fully parse request body due to large argument count',severity:2"

SecRule REQBODY_ERROR "!@eq 0" \
    "id:'200002',phase:2,t:none,log,deny,status:${MODSEC_DENY_STATUS},msg:'Failed to parse request body.',logdata:'%{reqbody_error_msg}',severity:2"

SecRule MULTIPART_STRICT_ERROR "!@eq 0" \
    "id:'200003',phase:2,t:none,log,deny,status:${MODSEC_DENY_STATUS}, \
msg:'Multipart request body failed strict validation: \
PE %{REQBODY_PROCESSOR_ERROR}, \
BQ %{MULTIPART_BOUNDARY_QUOTED}, \
BW %{MULTIPART_BOUNDARY_WHITESPACE}, \
DB %{MULTIPART_DATA_BEFORE}, \
DA %{MULTIPART_DATA_AFTER}, \
DH %{MULTIPART_DUPLICATE_PART_HEADER}, \
HF %{MULTIPART_HEADER_FOLDING}, \
LF %{MULTIPART_LF_LINE}, \
SM %{MULTIPART_MISSING_SEMICOLON}, \
IQ %{MULTIPART_INVALID_QUOTING}, \
IP %{MULTIPART_INVALID_PART}, \
IH %{MULTIPART_INVALID_HEADER_FOLDING}, \
FL %{MULTIPART_FILE_LIMIT_EXCEEDED}'"

SecRule MULTIPART_UNMATCHED_BOUNDARY "@eq 1" \
    "id:'200004',phase:2,t:none,log,deny,status:${MODSEC_DENY_STATUS},msg:'Multipart parser detected a possible unmatched boundary.'"

# Internal errors, such as a regular expression over the limits of modsecurity/modsecurity.conf.
SecRule TX:/^MSC_/ "!@streq 0" \
    "id:'200005',phase:2,t:none,log,deny,status:${MODSEC_DENY_STATUS},msg:'ModSecurity internal error flagged: %{MATCHED_VAR_NAME}'"

# Audit log. MODSEC_AUDIT_ENGINE is derived from MODSEC_AUDIT_LOG by docker-entrypoint.d/18-kickedro-render.sh.
SecAuditEngine ${MODSEC_AUDIT_ENGINE}
SecAuditLog ${MODSEC_AUDIT_LOG}
SecAuditLogFormat ${MODSEC_AUDIT_FORMAT}

# CRS settings: blocking paranoia level and anomaly score thresholds.
SecAction \
    "id:900000,\
    phase:1,\
    pass,\
    t:none,\
    nolog,\
    setvar:tx.blocking_paranoia_level=${MODSEC_PARANOIA}"

SecAction \
    "id:900110,\
    phase:1,\
    pass,\
    t:none,\
    nolog,\
    setvar:tx.inbound_anomaly_score_threshold=${MODSEC_ANOMALY_INBOUND},\
    setvar:tx.outbound_anomaly_score_threshold=${MODSEC_ANOMALY_OUTBOUND}"

# CRS policy: the allowed request methods (rule 911100) and request body content types (rule 920420). The CRS's
# REQUEST-901-INITIALIZATION.conf sets its own defaults only when these are not set yet; the settings' defaults are
# the same lists (tests/edge_smoke.sh compares them with the built CRS).
SecAction \
    "id:900200,\
    phase:1,\
    pass,\
    t:none,\
    nolog,\
    setvar:'tx.allowed_methods=${MODSEC_ALLOWED_METHODS}'"

SecAction \
    "id:900220,\
    phase:1,\
    pass,\
    t:none,\
    nolog,\
    setvar:'tx.allowed_request_content_type=${MODSEC_ALLOWED_REQUEST_CONTENT_TYPE}'"
